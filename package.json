{
  "name": "hashi-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "packages/frontend"
  ],
  "scripts": {
    "dev:frontend": "bun run --cwd packages/frontend --bun dev",
    "dev:backend": "cd packages/backend && uv run uvicorn main:app --reload",
    "build:frontend": "NODE_ENV=production bun run --cwd packages/frontend --bun build",
    "lint": "bun run --cwd packages/frontend --bun lint"
  }
}
